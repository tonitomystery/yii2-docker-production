
ARG PHP_VERSION=8.4
ARG NGINX_VARIANT=fpm-latest-nginx-min
FROM yiisoftware/yii2-php:${PHP_VERSION}-${NGINX_VARIANT}

WORKDIR /app


RUN apt-get update && apt-get install -y --no-install-recommends \
    awscli git unzip curl \
    libpng-dev libjpeg-dev libfreetype6-dev \
    libmariadb-dev libmariadb-dev-compat \
    libpq-dev libmagickwand-dev imagemagick \
    libmemcached-dev libssl-dev zlib1g-dev \
    libzip-dev pkg-config \
    libgmp-dev \
    libicu-dev \
    locales cron supervisor \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
    pdo_mysql \
    pdo_pgsql \
    gd \
    zip \
    intl \
    pcntl \
    gmp \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# COPY nginx.conf /etc/nginx/conf.d/default.conf

# imagick y memcached se compilan desde los tags oficiales en GitHub en lugar de
# "pecl install": pecl.php.net falla de forma intermitente ("does not have REST xml
# available") y además sin versión fija el build no es reproducible.
ARG IMAGICK_VERSION=3.8.1
ARG MEMCACHED_VERSION=3.4.0
RUN set -eux; \
    docker-php-source extract; \
    mkdir -p /usr/src/php/ext/imagick /usr/src/php/ext/memcached; \
    curl -fsSL "https://github.com/Imagick/imagick/archive/refs/tags/${IMAGICK_VERSION}.tar.gz" \
        | tar -xz --strip-components=1 -C /usr/src/php/ext/imagick; \
    # El tarball de git trae la versión como placeholder (PECL la sustituye al empaquetar);
    # sin esto phpversion('imagick') devuelve "@PACKAGE_VERSION@" y composer falla.
    sed -i "s/@PACKAGE_VERSION@/${IMAGICK_VERSION}/" /usr/src/php/ext/imagick/php_imagick.h; \
    curl -fsSL "https://github.com/php-memcached-dev/php-memcached/archive/refs/tags/v${MEMCACHED_VERSION}.tar.gz" \
        | tar -xz --strip-components=1 -C /usr/src/php/ext/memcached; \
    docker-php-ext-install -j"$(nproc)" imagick memcached; \
    docker-php-source delete; \
    php -r 'exit(phpversion("imagick") === getenv("IMAGICK_VERSION") ? 0 : 1);'; \
    php -m | grep -qx memcached

RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && php -r "unlink('composer-setup.php');"

